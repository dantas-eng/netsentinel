# Exemplo; preencher fora do Git. O programa lê variáveis já exportadas.
APP_MODE=lab
DATABASE_URL=sqlite:////var/lib/netsentinel-backend/backend.sqlite
SECRET_KEY=SUBSTITUIR_POR_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
OPERATOR_USERNAME=operador
OPERATOR_PASSWORD_HASH=SUBSTITUIR_POR_HASH_WERKZEUG
LAB_CONFIG=/etc/netsentinel/lab.json
LAB_MAX_OBSERVATIONS=10000
PORT=8080
# Cloud: APP_MODE=cloud, DATABASE_URL=postgresql+psycopg://..., sem LAB_CONFIG.
