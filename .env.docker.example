# Copiar para .env.docker. Gerar valores antes de subir o Compose; não há senha padrão.
# Senha do Postgres: usar 64 caracteres hexadecimais (segura para a DATABASE_URL).
SYNTHETIC_POSTGRES_PASSWORD=SUBSTITUIR_POR_64_HEXADECIMAIS
SYNTHETIC_SECRET_KEY=SUBSTITUIR_POR_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
SYNTHETIC_OPERATOR_USERNAME=operador
# Aspas simples preservam os $ do hash Werkzeug na leitura pelo Compose.
SYNTHETIC_OPERATOR_PASSWORD_HASH='SUBSTITUIR_POR_HASH_WERKZEUG'
